{
  "name": "SIMKL Scrobbler",
  "identifier": "io.github.prestinesnail.iina-simkl-scrobbler",
  "version": "1.1.31",
  "ghRepo": "prestinesnail/iina-simkl-scrobbler",
  "ghVersion": 33,
  "description": "Real-time Simkl scrobbling for movies, TV, and anime playing in IINA.",
  "author": {
    "name": "prestinesnail",
    "url": "https://github.com/prestinesnail"
  },
  "entry": "main.js",
  "sidebarTab": {
    "name": "SIMKL"
  },
  "permissions": [
    "show-osd",
    "show-alert",
    "video-overlay",
    "network-request",
    "file-system"
  ],
  "allowedDomains": [
    "api.simkl.com",
    "api.introdb.app",
    "simkl.com",
    "simkl.in",
    "wsrv.nl"
  ],
  "preferencesPage": "preferences.html",
  "preferenceDefaults": {
    "simkl_client_id": "594766b276bb4c56547b98e4f2bd73846852405ff3abb2f4cc0a95d5631c5acb",
    "scrobble_enabled": true,
    "status_osd": true,
    "osd_seconds": 4,
    "debug_osd": false,
    "pause_debounce_ms": 400,
    "title_language": "english",
    "overlay_enabled": true,
    "overlay_seconds": 8,
    "overlay_resume_seconds": 2,
    "overlay_position": "bottom-left",
    "overlay_offset_px": 24,
    "skip_intro_enabled": true,
    "track_rewatches": false,
    "auth_action_kind": "",
    "auth_action_nonce": ""
  }
}
